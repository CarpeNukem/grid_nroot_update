{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grid-cyberdeck-api",
	"main": "src/index.ts",
	// Highest date supported by the workerd bundled with wrangler 4.123.0.
	// Raise it together with the wrangler version, never ahead of it.
	"compatibility_date": "2025-10-11",

	// Lets the admin page be imported as a string and served with headers this
	// Worker controls, rather than needing a separate static-assets deployment.
	"rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],

	// Structured request logs. See src/observability/log.ts.
	"observability": {
		"enabled": true
	},

	// Non-secret configuration only. Secrets belong in .dev.vars (local, git-ignored)
	// or `wrangler secret put` (deployed). See .dev.vars.example.
	"vars": {
		"ENVIRONMENT": "development",
		"SCHEMA_VERSION": "1",
		// The Worker serves R2 objects itself from /media, so this works locally
		// with no public bucket. Point it at a CDN origin later if one is added.
		"PUBLIC_MEDIA_BASE_URL": "http://127.0.0.1:8787/media",
		// Exact origin of the Pages admin site. Admin CORS is never a wildcard.
		"ADMIN_ALLOWED_ORIGIN": "http://127.0.0.1:8788"
	},

	// Local development bindings. `database_id` is a placeholder: `wrangler dev` and
	// the test pool use a local SQLite file and ignore it. A real id is only needed
	// for `--remote`, and must not be committed.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "grid-cyberdeck-dev",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "grid-cyberdeck-media-dev"
		}
	],

	// Public reads are metered per caller. Writes sit behind Cloudflare Access,
	// so this guards the read quota rather than access: an unthrottled client can
	// exhaust D1 reads and blank the venue screens.
	"ratelimits": [
		{
			"name": "PUBLIC_READ_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],

	// Deployed environments are declared explicitly so `wrangler deploy` alone
	// cannot ship the development settings above. That matters more than it
	// looks: with ENVIRONMENT set to "development" the Worker accepts an
	// `x-dev-admin-email` header in place of a Cloudflare Access token, which is
	// exactly right locally and an authentication bypass anywhere else.
	//
	// Deploy with:  npx wrangler deploy --env production
	"env": {
		"production": {
			"name": "grid-cyberdeck-api",

			// No workers.dev URL. Access protects the custom domain; a second
			// hostname that Access does not cover would simply route around it.
			"workers_dev": false,

			// Binding the hostname needs nroot.io to be an active zone in the same
			// Cloudflare account. The domain is registered but still on the
			// registrar's nameservers, so this fails until it is moved across.
			"routes": [{ "pattern": "api.nroot.io", "custom_domain": true }],

			"vars": {
				// The single most important line here. Anything other than
				// "development" disables the local sign-in path entirely.
				"ENVIRONMENT": "production",
				"SCHEMA_VERSION": "1",
				// The Worker serves R2 from its own /media path.
				"PUBLIC_MEDIA_BASE_URL": "https://api.nroot.io/media",
				// Same origin: the admin page is served by this Worker.
				"ADMIN_ALLOWED_ORIGIN": "https://api.nroot.io"
			},

			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "grid-cyberdeck",
					// An identifier, not a credential: it does nothing without
					// authenticated access to the account, so it is committed.
					"database_id": "71d547fc-1c41-4a7f-ad5c-c7c2b1000805",
					"migrations_dir": "migrations"
				}
			],

			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "grid-cyberdeck-media"
				}
			],

			"ratelimits": [
				{
					"name": "PUBLIC_READ_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 60, "period": 60 }
				}
			]
		}
	}
}

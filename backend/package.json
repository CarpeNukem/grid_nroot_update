{
	"name": "grid-cyberdeck-backend",
	"version": "0.1.0",
	"private": true,
	"description": "Cloudflare Worker API for The Grid Cyberdeck plugin.",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "wrangler dev",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply grid-cyberdeck-dev --local",
		"seed:build": "tsx scripts/import-seed.ts",
		"seed:local": "npm run seed:build && wrangler d1 execute grid-cyberdeck-dev --local --file=.wrangler/seed.sql",
		"check": "npm run format:check && npm run typecheck && npm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@cloudflare/vitest-pool-workers": "^0.9.0",
		"@cloudflare/workers-types": "^5.20260816.1",
		"@types/node": "^26.2.0",
		"tsx": "^4.23.12",
		"typescript": "^5.7.0",
		"vitest": "~3.2.0",
		"wrangler": "^4.0.0"
	}
}
